<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="12"
      prefWidth="700"
      prefHeight="650"
      style="-fx-background-color: #E5D8C8;"
      xmlns="http://javafx.com/javafx/21.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.registropaciente.PacienteController">

   <padding>
      <Insets top="20"
              right="40"
              bottom="20"
              left="40"/>
   </padding>

   <Label text="REGISTRO DE PACIENTES"
          style="
           -fx-font-size: 24px;
           -fx-font-weight: bold;
           -fx-text-fill: #159B9B;
           "/>

   <Label text="Nombres"
          maxWidth="Infinity"
          style="-fx-font-weight: bold;"/>

   <TextField fx:id="txtnombres"
              promptText="Ingrese los nombres"/>

   <Label text="Apellidos"
          maxWidth="Infinity"
          style="-fx-font-weight: bold;"/>

   <TextField fx:id="txtapellidos"
              promptText="Ingrese los apellidos"/>

   <Label text="Género"
          maxWidth="Infinity"
          style="-fx-font-weight: bold;"/>

   <HBox alignment="CENTER"
         spacing="25">

      <RadioButton fx:id="radioMasculino"
                   text="Masculino">

         <toggleGroup>
            <ToggleGroup fx:id="grupoGenero"/>
         </toggleGroup>

      </RadioButton>

      <RadioButton fx:id="radioFemenino"
                   text="Femenino"
                   toggleGroup="$grupoGenero"/>

   </HBox>

   <CheckBox fx:id="checkEnfermo"
             text="Paciente enfermo"/>

   <Button text="Agregar paciente"
           onAction="#agregarOnclick"
           prefWidth="170"
           style="
            -fx-background-color: #159B9B;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            "/>

   <HBox alignment="CENTER"
         spacing="5">

      <Label text="Pacientes registrados:"
             style="-fx-font-weight: bold;"/>

      <Label fx:id="lblContador"
             text="0"
             style="
               -fx-text-fill: #159B9B;
               -fx-font-weight: bold;
               "/>

   </HBox>

   <Label text="Pacientes registrados"
          maxWidth="Infinity"
          style="
           -fx-font-weight: bold;
           -fx-text-fill: #159B9B;
           "/>

   <TableView fx:id="tablaPacientes"
              prefHeight="230">

      <columns>

         <TableColumn fx:id="columnaNombres"
                      text="Nombres"
                      prefWidth="170"/>

         <TableColumn fx:id="columnaApellidos"
                      text="Apellidos"
                      prefWidth="170"/>

         <TableColumn fx:id="columnaGenero"
                      text="Género"
                      prefWidth="120"/>

         <TableColumn fx:id="columnaEstado"
                      text="Estado"
                      prefWidth="130"/>

      </columns>

   </TableView>

</VBox>